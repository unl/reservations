<h1 class="dcf-txt-h4" id="signup-list-header">Signup List for <em><%= event.title %></em></h1>

<% if event.max_signups %>
    <p>
    <%= event.signups.length %> Filled of <%= event.max_signups %> Total Slots
    </p>
<% end %>

<form class="dcf-form" id="attendance" action="" method="POST">
    <table class="dcf-w-100% dcf-table dcf-table-bordered">

        <% if !event.signups.empty? %>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Attended</th>
                <% if event_type_allow_signup_deletions(event_type_id) %>
                    <th>Delete Signup</th>
                <% end %>
                </tr>
            </thead>
        <% else %>
            <p>So far, no one has signed up for this event.</p>
        <% end %>
        <tbody>
            <% event.signups.each do |signup| %>
                <tr>
                    <td><%= signup.name %></td>
                    <td><%= signup.email %></td>
                    <td>
                        <div class="dcf-input-checkbox">
                            <input <%= 'checked="checked"' if signup.attended == 1 %> id="attendance-checkbox_<%= signup.id %>" type="checkbox" name="attendance_<%= signup.id %>"  >
                            <label for="attendance-checkbox_<%= signup.id %>"></label>
                        </div>
                    </td>
                    <% if event_type_allow_signup_deletions(event_type_id) %>
                        <td>
                            <div class="dcf-input-checkbox">
                                <input id="deletion-checkbox_<%= signup.id %>" type="checkbox" name="deletion_<%= signup.id %>"  >
                                <label for="deletion-checkbox_<%= signup.id %>"></label>
                            </div>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        </tbody>
    </table>
    <br>

    <div class="dcf-form-group">
        <label for="add-user">Add User(s): <em>(use Ctrl/Cmd to select multiple)</em></label>
        <select class="dcf-txt-sm" multiple="multiple" size="8" id="add-user" name="add_user[]" >
            <% users.sort{|x,y| x.sortable_name.downcase <=> y.sortable_name.downcase}.each do |user| %>
            <option value="<%= user.id %>"><%= user.sortable_name %> (<%= user.email %>) (User #<%= user.id %>)</option>
            <% end %>
        </select>
    </div>
    <br>

    <button class="dcf-btn dcf-btn-primary" type="submit">Save</button>
</form>
