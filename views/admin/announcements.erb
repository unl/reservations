<div class="dcf-d-flex dcf-flex-row dcf-jc-between dcf-ai-center dcf-mb-4">
    <h2>Announcements</h2>
    <a href="/admin/announcements/create/" class="dcf-btn dcf-btn-primary">Create Announcement</a>
</div>

<table class="dcf-table dcf-table-striped dcf-table-responsive dcf-w-100% dcf-mt-6 dcf-mb-6" aria-describedby="announcements-list-table">
    <thead>
        <tr class="dcf-d-grid dcf-grid-cols-5 dcf-w-100%">
            <th scope="col" class="dcf-col-span-2">Announcements</th>
            <th scope="col" class="dcf-col-span-2">Status</th>
            <th scope="col">Edit</th>
        </tr>
    </thead>
    <tbody>
    <% announcements.each do |announcement| %>
        <tr class="dcf-d-grid dcf-grid-cols-5 dcf-w-100%">
            <td class="dcf-col-span-2">
                <%= announcement.header %>
            </td>
            <td class="dcf-col-span-2">
                <% if announcement.status? %>
                    Active
                <% else %>
                    Inactive
                <% end %>
            </td>
            <td>
                <a href="/admin/announcements/edit/<%= announcement.id %>/" class="dcf-btn dcf-btn-primary">Edit</a>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>